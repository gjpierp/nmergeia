# =====================================================================
# CONFIGURACIÓN DE IGNORADOS DE GIT (.gitignore) - NMERGE
# =====================================================================

# 1. ARCHIVOS DE ENTORNO Y SECRETOS (Zero-Trust Security)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
bcknd/.env

# 2. DEPENDENCIAS Y CACHÉS DE ENTORNO
node_modules/
**/node_modules/
.oxlint_cache/
.vitest_cache/
coverage/
.vendor/

# 3. ENTREGABLES, SALIDAS DE BUILD Y BINARIOS (Releases & Dist)
dist/
dist_electron/
dist_portable/
releases/
build/
out/

# 4. ARCHIVOS Y DIRECTORIOS TEMPORALES / SCRATCH
scratch/
.backup_source/
$null
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. CONFIGURACIONES DE EDITORES E IDEs
.vscode/
.idea/
*.swp
*.swo
*.code-workspace
erpgp.code-workspace
erpgp.postman_collection.json

# 6. ARCHIVOS DEL SISTEMA OPERATIVO
.DS_Store
Thumbs.db
desktop.ini

# 7. AGENTES Y MEMORIA TEMPORAL DE IA
.agents/
.gemini/
.aider*
.docs/

# 8. SCRIPTS DE DEPURACIÓN TEMPORALES Y BASURA DE DESARROLLO
fix.cjs
update_locales*.cjs
*.tmp
