{
  "name": "NMerge",
  "private": true,
  "version": "1.2.27",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev:frontend": "vite --port 3009",
    "dev:backend": "cross-env PORT=3001 node server.js",
    "dev": "node server.js",
    "build": "node src/shared/lib/generate-sitemap.js && vite build && node src/shared/lib/prerender.js",
    "sitemap": "node src/shared/lib/generate-sitemap.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "electron:build": "node build-exe.js",
    "obfuscate": "node obfuscate.js",
    "test": "vitest",
    "start": "node server.js",
    "heroku-postbuild": "npm run build",
    "i18n:sync": "node src/shared/locales/sync.js",
    "docs:sync": "node src/shared/locales/sync-docs.js"
  },
  "build": {
    "appId": "com.antigravity.nmerge",
    "productName": "NMerge",
    "directories": {
      "output": "dist_portable"
    },
    "files": [
      "dist/**/*",
      {
        "from": "dist",
        "to": ".",
        "filter": [
          "server.js",
          "electron-main.cjs",
          "preload.cjs"
        ]
      },
      "configs/**/*",
      "src/assets/**/*",
      "public/**/*"
    ],
    "icon": "src/assets/icon.ico",
    "win": {
      "icon": "src/assets/icon.ico",
      "target": [
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico",
      "installerHeaderIcon": "src/assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NMerge"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "8.6.0",
    "fast-xml-parser": "5.10.1",
    "gsap": "^3.15.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "ignore": "^7.0.6",
    "js-yaml": "5.2.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "3.0.0",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "stripe": "22.3.2",
    "three": "^0.185.1",
    "xlsx": "^0.18.5",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^4.1.1",
    "jsdom": "29.1.1",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.10",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "dompurify": "^3.4.11"
  }
}
